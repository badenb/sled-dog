#!/usr/bin/env python3
"""Use an existing checkout environment without requiring shell activation."""
import os
from pathlib import Path
import sys

checkout = Path(__file__).resolve().parent
python = checkout / '.venv' / ('Scripts/python.exe' if os.name == 'nt' else 'bin/python')
if python.is_file() and Path(sys.prefix).resolve() != (checkout / '.venv').resolve():
    os.execv(str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]])

from sled_dog.cli import main

if __name__ == '__main__':
    raise SystemExit(main())
